{
  "name": "@splex/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@splex/shared-types": "workspace:*",
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.0",
    "fastify-plugin": "^5.0.1",
    "fastify-sse-v2": "^4.2.2",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
